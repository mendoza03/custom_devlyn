<odoo>
    <record id="view_helpdesk_cancel_ticket_wizard_form" model="ir.ui.view">
        <field name="name">helpdesk.cancel.ticket.wizard.form</field>
        <field name="model">helpdesk.cancel.ticket.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Ticket">
                <sheet>
                    <group>
                        <field name="ticket_id"/>
                        <field name="user_id"/>
                        <field name="reason_id"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="note"
                               placeholder="Add an optional internal cancellation note..."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm Cancellation"
                            name="action_confirm_cancel"
                            type="object"
                            class="btn-primary"/>
                    <button string="Discard"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

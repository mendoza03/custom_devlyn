<odoo>
    <record id="helpdesk_ticket_view_form_inherit_cancel_reason" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.cancel.reason</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">

            <!-- 👇 IMPORTANTE: campos disponibles para el header -->
            <xpath expr="//form" position="inside">
                <field name="cancel_reason_id" invisible="1"/>
                <field name="is_cancelled" invisible="1"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_open_cancel_wizard"
                        type="object"
                        string="Cancel Ticket"
                        class="btn-danger"
                        groups="helpdesk_inherit.group_helpdesk_cancel_manager"
                        invisible="cancel_reason_id != False"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <group string="Cancellation"
                       invisible="not is_cancelled">
                    <field name="is_cancelled" invisible="1"/>
                    <field name="cancel_reason_id"/>
                    <field name="cancelled_by_id"/>
                    <field name="cancelled_date"/>
                    <field name="cancel_note"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
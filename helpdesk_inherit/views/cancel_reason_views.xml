<odoo>
    <record id="view_helpdesk_cancel_reason_list" model="ir.ui.view">
        <field name="name">helpdesk.cancel.reason.list</field>
        <field name="model">helpdesk.cancel.reason</field>
        <field name="arch" type="xml">
            <list string="Cancellation Reasons">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_helpdesk_cancel_reason_form" model="ir.ui.view">
        <field name="name">helpdesk.cancel.reason.form</field>
        <field name="model">helpdesk.cancel.reason</field>
        <field name="arch" type="xml">
            <form string="Cancellation Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_cancel_reason" model="ir.actions.act_window">
        <field name="name">Cancellation Reasons</field>
        <field name="res_model">helpdesk.cancel.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first cancellation reason.
            </p>
        </field>
    </record>

    <menuitem id="menu_helpdesk_cancel_reason"
          name="Cancellation Reasons"
          parent="helpdesk.helpdesk_menu_config"
          action="action_helpdesk_cancel_reason"
          sequence="80"
          groups="helpdesk_inherit.group_helpdesk_cancel_manager"/>
</odoo>

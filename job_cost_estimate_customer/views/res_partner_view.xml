<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="job_estimate_button_res_partner_form_view" model="ir.ui.view">
        <field name="name">job.estimate.button.res.partner.form.view</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="show_job_estimate_partner" icon="fa-tasks">
                        <field string="Estimate" name="job_estimate_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
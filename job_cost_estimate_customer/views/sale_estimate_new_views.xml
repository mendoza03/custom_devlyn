<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="view_sale_estimate_form_job" model="ir.ui.view">
            <field name="name">sale.estimate.job.form</field>
            <field name="model">sale.estimate.job</field>
            <field name="arch" type="xml">
                <form string="Job Estimate" class="o_sale_order">
                <header>
                    <button name="estimate_confirm" type="object" string="Confirm" invisible="state not in ('draft','sent')" class="btn-primary" groups="sales_team.group_sale_salesman"/>
                    <button name="estimate_approve" type="object" string="Approve" invisible="state not in 'confirm'" class="btn-primary" groups="sales_team.group_sale_salesman"/>
                    <button name="estimate_reject" type="object" string="Reject" invisible="state not in 'confirm'" 
                        groups="sales_team.group_sale_salesman"/>
                    <button name="estimate_to_quotation" type="object" string="Create Quotation" invisible="state not in 'approve'" class="btn-primary"/>
                    <button name="action_estimate_send" type="object" string="Send by Email" invisible="state not in ('draft','sent','confirm','approve','quotesend')" class="btn-primary" groups="sales_team.group_sale_salesman"/>
                    <button name="reset_todraft" type="object" string="Reset to Draft" invisible="state not in ('cancel','approve','reject')" groups="sales_team.group_sale_salesman"/>
                    <button name="estimate_cancel" type="object" string="Cancel" invisible="state not in ('draft','sent')"/>
                    <field name="state" widget="statusbar" string="confirm"  
                                    statusbar_visible="draft,sent,confirm,approve,quotesend"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="view_custom_quotation" type="object" class="oe_stat_button" icon="fa-dollar" string="Quotation"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" context="{'search_default_customer':1, 'show_address': 1}" options="{&quot;always_reload&quot;: True}" readonly="state in ('approve','quotesend','cancel','reject')"/>
                            <!-- <field name="pricelist_id" readonly="state in ('approve','quotesend','cancel','reject')" groups="product.group_sale_pricelist"/> -->
                            <field name="pricelist_id" readonly="state in ('approve','quotesend','cancel','reject')"/>
                            <field name="payment_term_id" readonly="state in ('approve','quotesend','cancel','reject')" options="{'no_create': True}"/>
                            <field name="reference" readonly="state in ('approve','quotesend','cancel','reject')"/>
                        </group>
                        <group>
                            <field name="estimate_date" readonly="state in ('approve','quotesend','cancel','reject')"/>
                            <field name="company_id" readonly="state in ('approve','quotesend','cancel','reject')" groups="base.group_multi_company"/>
                            <field name="currency_id" readonly="state in ('approve','quotesend','cancel','reject')" groups="base.group_multi_currency"/>
                            <field name="project_id" readonly="state in ('approve','quotesend','cancel','reject')"/>
                            <field name="analytic_id" readonly="state in ('approve','quotesend','cancel','reject')"/>
                            <field name="job_type_ids" widget="many2many_tags" readonly="state in ('approve','quotesend','cancel','reject')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Material Estimation">
                            <field name="estimate_ids"  context="{'default_analytic_id':analytic_id,'default_job_type':'material'}" readonly="state in ('approve','quotesend','cancel','reject')" nolabel="1" widget="section_and_note_one2many">
                                <list editable="bottom" limit="500">
                                    <control>
                                        <create name="add_line_control" string="Add a line"/>
                                        <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                        <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                                    </control>
                                    <field name="sequence" widget="handle" />
                                    <field name="display_type" column_invisible="1"/>
                                    <field name="job_type" required="not display_type"/>
                                    <field name="product_id" required="not display_type"/>
                                    <field name="product_description" required="not display_type"/>
                                    <field name="product_uom_qty" required="not display_type"/>
                                    <field name="product_uom" groups="uom.group_uom" required="not display_type"/>
                                    <field name="price_unit" required="not display_type"/>
                                    <field name="discount" required="not display_type"/>
                                    <field name="price_subtotal" required="not display_type"/>
                                    <field name="estimate_id" column_invisible="1"/> 
                                    <field name="name" widget="section_and_note_text" invisible="display_type not in ('line_section', 'line_note')"  nolabel="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Labour Estimation">
                            <field name="labour_estimate_line_ids" context="{'default_analytic_id':analytic_id,'default_job_type':'labour'}" readonly="state in ('approve','quotesend','cancel','reject')" nolabel="1" widget="section_and_note_one2many">
                                <list editable="bottom" limit="500">
                                    <control>
                                        <create name="add_line_control" string="Add a line"/>
                                        <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                        <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                                    </control>
                                    <field name="sequence" widget="handle" />
                                    <field name="display_type" column_invisible="1"/>
                                    <field name="job_type" required="not display_type"/>
                                    <field name="product_id" required="not display_type"/>
                                    <field name="product_description" required="not display_type"/>
                                    <field name="product_uom_qty" required="not display_type"/>
                                    <field name="product_uom" groups="uom.group_uom" required="not display_type"/>
                                    <field name="price_unit" required="not display_type"/>
                                    <field name="discount" required="not display_type"/>
                                    <field name="price_subtotal" required="not display_type"/>
                                    <field name="estimate_id" column_invisible="1"/> 
                                    <field name="name" widget="section_and_note_text" invisible="display_type not in ('line_section', 'line_note')"  nolabel="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Overhead Estimation">
                            <field name="overhead_estimate_line_ids" context="{'default_analytic_id':analytic_id,'default_job_type':'overhead'}" readonly="state in ('approve','quotesend','cancel','reject')" nolabel="1" widget="section_and_note_one2many">
                                <list editable="bottom" limit="500">
                                    <control>
                                        <create name="add_line_control" string="Add a line"/>
                                        <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                        <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                                    </control>
                                    <field name="sequence" widget="handle" />
                                    <field name="display_type" column_invisible="1"/>
                                    <field name="job_type" required="not display_type"/>
                                    <field name="product_id" required="not display_type"/>
                                    <field name="product_description" required="not display_type"/>
                                    <field name="product_uom_qty" required="not display_type"/>
                                    <field name="product_uom" groups="uom.group_uom" required="not display_type"/>
                                    <field name="price_unit" required="not display_type"/>
                                    <field name="discount" required="not display_type"/>
                                    <field name="price_subtotal" required="not display_type"/>
                                    <field name="estimate_id" column_invisible="1"/> 
                                    <field name="name" widget="section_and_note_text" invisible="display_type not in ('line_section', 'line_note')"  nolabel="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Info">
                            <group>
                                <group>
                                    <field name="source" readonly="state in ('approve','quotesend','cancel','reject')"/>
                                    <field name="user_id" readonly="state in ('approve','quotesend','cancel','reject')"/>
                                </group>
                                <group>
                                    <field name="team_id" readonly="state in ('approve','quotesend','cancel','reject')"/>
                                    <field name="quotation_id" readonly="state in ('approve','quotesend','cancel','reject')"/>
                                </group>
                            </group>
                        </page>
                        <page string="Aditional Notes">
                            <field name="note" readonly="state in ('approve','quotesend','cancel','reject')" placeholder="Internal Note ..."/>
                        </page>
                    </notebook>
                    <group col="12" class="oe_custom_tab">
                        <group colspan="8" string="Description of Jobs Estimate">
                            <field name="description" colspan="4"  class="oe_inline" readonly="state in ('approve','quotesend','cancel','reject')" placeholder="Terms and conditions ..." nolabel="1"/>
                        </group>
                        <group colspan="4">
                            <group class="oe_subtotal_footer oe_right" name="estimate_total">
                                <field name="total" widget="monetary"/>
                                <field name="labour_total" widget="monetary"/>
                                <field name="overhead_total" widget="monetary"/>
                                <field name="estimate_total" widget="monetary"/>
                            </group>
                        </group>
                    </group>
                </sheet>
                <chatter/>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div> -->
                </form>
            </field>
        </record>
        
        <record id="view_sale_estimate_tree_job" model="ir.ui.view">
            <field name="name">sale.estimate.job.list</field>
            <field name="model">sale.estimate.job</field>
            <field name="priority">4</field>
            <field name="arch" type="xml">
                <list string="Estimate">
                    <field name="number"/>
                    <field name="partner_id"/>
                    <field name="estimate_date"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="total" sum="Material Estimate" widget="monetary" string="Material Estimate"/>
                    <field name="labour_total" sum="Labour Estimate" widget="monetary" string="Labour Estimate"/>
                    <field name="overhead_total" sum="Overhead Estimate" widget="monetary" string="Overhead Estimate"/>
                    <field name="estimate_total" sum="Total" widget="monetary" string="Total"/>
                   <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                    <field name="activity_ids" widget="list_activity" optional="show"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="state" widget="badge" 
                    decoration-info="state in ('draft','approve')"
                    decoration-success="state in ('confirm','quotesend','sent')"
                    decoration-muted="state in ('cancel','reject')"
                    optional="show"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="view_sale_estimate_kanban_job">
            <field name="name">view.sale.estimate.kanban.job</field>
            <field name="model">sale.estimate.job</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="number"/>
                    <field name="partner_id"/>
                    <field name="estimate_total" widget="monetary"/>
                    <field name="estimate_date"/>
                    <field name="state"/>
                    <field name="currency_id" groups="base.group_multi_currency"/>
                    <templates>
                        <t t-name="card">
                            <div class="row mb4">
                                <div class="col-12">
                                    <field class="fw-bold" name="partner_id" invisible="not partner_id"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <field name="number"/>
                                </div>
                                <div class="col-6">
                                    <field class="float-end" name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'cancel': 'default', 'quotesend': 'success'}}"/>
                                </div>
                            </div>
                            <footer class="p-0">
                                 <field name="estimate_date"/>
                                 <field name="activity_ids" widget="kanban_activity"/>
                            </footer>
                            <footer class="p-0">
                                 <strong><field name="estimate_total" widget="monetary"/></strong>
                                 <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                            </footer>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_sale_estimate_calendar_job" model="ir.ui.view">
            <field name="name">view.sale.estimate.calendar.job</field>
            <field name="model">sale.estimate.job</field>
            <field name="arch" type="xml">
                <calendar string="Estimate" date_start="estimate_date" color="state" hide_time="true" event_limit="5">
                    <field name="currency_id" invisible="1"/>
                    <field name="partner_id" avatar_field="avatar_128"/>
                    <field name="estimate_total" widget="monetary"/>
                    <field name="state" filters="1" invisible="1"/>
                </calendar>
            </field>
        </record>

        <record model="ir.ui.view" id="view_sale_estimate_graph_job">
            <field name="name">view.sale.estimate.graph.job</field>
            <field name="model">sale.estimate.job</field>
            <field name="arch" type="xml">
                <graph string="Estimate" sample="1">
                    <field name="partner_id"/>
                    <field name="estimate_total" type="measure"/>
                </graph>
            </field>
        </record>

        <record model="ir.ui.view" id="view_sale_estimate_pivot_job">
            <field name="name">view.sale.estimate.pivot.job</field>
            <field name="model">sale.estimate.job</field>
            <field name="arch" type="xml">
                <pivot string="Estimate" sample="1">
                    <field name="estimate_date" type="row"/>
                    <field name="estimate_total" type="measure"/>
                </pivot>
            </field>
        </record>
        
        <record id="sale_estimate_search_view_job" model="ir.ui.view">
            <field name="name">sale.estimate job search</field>
            <field name="model">sale.estimate.job</field>
            <field name="arch" type="xml">
                <search string="Sale Estimate search" >
                    <field name="number"/>
                    <field name="partner_id"/>
                    <field name="estimate_date"/>
                    <field name="currency_id" groups="base.group_multi_currency"/>
                    <field name="user_id"/>
                    <field name="team_id"/>
                    <!-- <field name="pricelist_id" groups="product.group_sale_pricelist"/> -->
                    <field name="pricelist_id"/>
                    <field name="payment_term_id"/>
                    <field name="state"/>
                    <group expand="0" string="Group By">
                        <filter string="Customer" name="customer" context="{'group_by':'partner_id'}"/>
                        <filter string="Currency" name="currency" context="{'group_by':'currency_id'}"/>
                        <filter string="Estimate Date" name="estimate_date" context="{'group_by':'estimate_date'}"/>
                        <filter string="Company" name="company" context="{'group_by':'company_id'}"/>
                        <filter string="State" name="state" context="{'group_by':'state'}"/>
                        <filter string="Sales Person" name="sales_person" context="{'group_by':'user_id'}"/>
                        <filter string="Sales Team" name="sales_team" context="{'group_by':'team_id'}"/>
                        <filter string="Pricelist" name="pricelist" context="{'group_by':'pricelist_id'}"/>
                        <filter string="Payment Term" name="payment_term" context="{'group_by':'payment_term_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_sale_estimate_activity_job" model="ir.ui.view">
            <field name="name">view.sale.estimate.activity.job</field>
            <field name="model">sale.estimate.job</field>
            <field name="arch" type="xml">
                <activity string="Estimate">
                    <templates>
                        <div t-name="activity-box">
                            <div>
                                <field name="number" display="full"/>
                                <field name="partner_id" muted="1" display="full"/>
                            </div>
                        </div>
                    </templates>
                </activity>
            </field>
        </record>
       
        <record id="action_estimate_job" model="ir.actions.act_window">
            <field name="name">Job Estimates</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sale.estimate.job</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        </record>



        <menuitem id="menu_sale_estimate_job" name="Job Estimates" action="action_estimate_job" parent="sale.sale_order_menu" sequence="0"/>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="job_estimate_button_project_view" model="ir.ui.view">
    <field name="name">job.estimate.button.project.view</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.edit_project"/>
    <field name="arch" type="xml">
        <xpath expr="//div[@name='button_box']" position="inside">
            <button class="oe_stat_button" type="object" name="show_job_estimate" icon="fa-tasks">
                    <field string="Estimate" name="job_estimate_count" widget="statinfo"/>
            </button>
        </xpath>
    </field>
    </record>

</odoo>
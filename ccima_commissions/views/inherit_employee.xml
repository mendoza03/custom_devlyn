<odoo>
    <record id="hr_employee_view_form_inherit_commission_scheme" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.commission.scheme</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Esquema de comisiones">
                    <group>
                        <group>
                            <field name="asesor"/>
                            <field name="kam"/>
                            <field name="gerente"/>
                            <field name="dvn"/>
                            <field name="cco"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

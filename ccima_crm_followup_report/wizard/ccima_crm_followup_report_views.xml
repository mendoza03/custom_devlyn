<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ccima_crm_followup_report_view_form" model="ir.ui.view">
        <field name="name">ccima.crm.followup.report.view.form</field>
        <field name="model">ccima.crm.followup.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="file" filename="filename" widget="binary" readonly="1"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Generate report" name="action_generate" type="object" invisible="state != 'get'" class="oe_highlight"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ccima_crm_followup_report_action" model="ir.actions.act_window">
        <field name="name">Folloup Report</field>
        <field name="res_model">ccima.crm.followup.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
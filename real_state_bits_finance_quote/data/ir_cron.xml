<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_move_cron_invoices" model="ir.cron">
        <field name="name">Create Automatic Invoices from Contracts</field>
        <field name="model_id" ref="real_estate_bits.model_property_contract"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().astimezone(pytz.timezone('America/Mexico_City')).replace(hour=0, minute=0).astimezone(pytz.utc) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
        <field name="state">code</field>
        <field name="code">model.generate_invoices()</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fastapi_endpoint_form_view_inherit_module_name" model="ir.ui.view">
        <field name="name">fastapi.endpoint.view.form.inherit</field>
        <field name="model">fastapi.endpoint</field>
        <field name="inherit_id" ref="fastapi.fastapi_endpoint_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='app']" position="after">
                <field name="real_estate_api_key" invisible="app != 'real_estate'" required="app != 'real_estate'"/>
            </xpath>
        </field>
    </record>
</odoo>
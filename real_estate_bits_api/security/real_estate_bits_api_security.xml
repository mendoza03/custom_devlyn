<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="real_estate_bits_app_user" model="res.users" context="{'no_reset_password': True, 'no_reset_password': True}">
        <field name="name">Real Estate Endpoint User</field>
        <field name="login">real_estate_bits_app_user</field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="notification_type">email</field> 
    </record>

    <record id="real_estate_bits_app_group" model="res.groups">
        <field name="name">Real Estate Endpoint Group</field>
        <field name="users" eval="[(4, ref('real_estate_bits_app_user'))]"/>
        <field name="implied_ids" eval="[(4, ref('fastapi.group_fastapi_endpoint_runner'))]"/>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!--Maintenance Equipment Inherit-->
        <record id="maintenance_equipment_inherit_form_view" model="ir.ui.view">
            <field name="name">maintenance.equipment.inherit.form.view</field>
            <field name="model">maintenance.equipment</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <header>
                        <button string="Create Maintenance Request" name="action_create_maintenance_request"
                                type="object" class="btn-primary"/>
                    </header>
                </xpath>
                <xpath expr="//field[@name='category_id']" position="before">
                    <field name="product_id" required="1" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="customer_id" options="{'no_create': True, 'no_create_edit': True}"/>
                </xpath>
            </field>
        </record>

        <!--Maintenance Request Inherit-->
        <record id="maintenance_request_inherit_form_view" model="ir.ui.view">
            <field name="name">maintenance.request.inherit.form.view</field>
            <field name="model">maintenance.request</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_maintenances_invoice_view"
                                icon="fa-pencil-square-o" invisible="total_invoiced == 0">
                            <field string="Invoices" name="total_invoiced" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_order_view" icon="fa-truck"
                                invisible="order_count == 0">
                            <field string="Delivery Orders" name="order_count" widget="statinfo"/>
                        </button>
                    </div>
                </xpath>
                <xpath expr="//form/header" position="inside">
                    <button string="Create Invoice" name="action_create_maintenance_invoice" type="object"
                            class="btn-primary" invisible="invoice_id != False"/>
                    <button string="Create Delivery Order" name="action_create_delivery_order" type="object"
                            class="btn-primary" invisible="delivery_order_id != False or invoice_id == False"/>
                </xpath>
                <xpath expr="//field[@name='equipment_id']" position="before">
                    <field name="customer_id" required="1" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="product_id" invisible="1"/>
                    <field name="invoice_id" invisible="1"/>
                    <field name="delivery_order_id" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='maintenance_type']" position="after">
                    <field name="warehouse_id" required="invoice_id != False" readonly="delivery_order_id != False"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </xpath>
                <xpath expr="//notebook/page[last()]" position="before">
                    <page name="required_parts" string="Required Spare Parts">
                        <field name="maintenance_spare_part_ids" nolabel="1" readonly="invoice_id != False">
                            <form>
                                <sheet>
                                    <group>
                                        <group>
                                            <field name="product_id" required="1"/>
                                            <field name="qty" required="1"/>
                                        </group>
                                        <group>
                                            <field name="price"/>
                                            <field name="sub_total"/>
                                            <field name="company_id" invisible="1"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                </sheet>
                            </form>
                            <list editable="bottom">
                                <field name="product_id" required="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="qty" required="1"/>
                                <field name="price"/>
                                <field name="sub_total"/>
                                <field name="company_id" column_invisible="True"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                        <div class="row">
                            <div class="col-9">
                            </div>
                            <div class="col-3" style="text-align: right;">
                                <h6>
                                    Total Estimations
                                    <hr style="margin: 5px;"/>
                                </h6>
                                Spare Part Price:
                                <field name="total_part_price"/>
                                <br/>
                                Service Charge:
                                <field name="total_service_charge"/>
                                <br/>
                                <hr style="margin: 5px;"/>
                                Total:
                                <field name="total"/>
                                <field name="company_id" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                            </div>
                        </div>
                    </page>
                    <page name="required_services" string="Required Services">
                        <field name="maintenance_service_ids" nolabel="1" readonly="invoice_id != False">
                            <form>
                                <sheet>
                                    <group>
                                        <group>
                                            <field name="product_id" required="1"/>
                                        </group>
                                        <group>
                                            <field name="service_charge"/>
                                            <field name="company_id" invisible="1"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                </sheet>
                            </form>
                            <list editable="bottom">
                                <field name="product_id" required="1"/>
                                <field name="service_charge"/>
                                <field name="company_id" column_invisible="True"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                        <div class="row">
                            <div class="col-9">
                            </div>
                            <div class="col-3" style="text-align: right;">
                                <h6>
                                    Total Estimations
                                    <hr style="margin: 5px;"/>
                                </h6>
                                Spare Part Price:
                                <field name="total_part_price"/>
                                <br/>
                                Service Charge:
                                <field name="total_service_charge"/>
                                <br/>
                                <hr style="margin: 5px;"/>
                                Total:
                                <field name="total"/>
                                <field name="company_id" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                            </div>
                        </div>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
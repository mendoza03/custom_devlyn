<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="rent_invoice_form_view" model="ir.ui.view">
            <field name="name">rent.invoice.form.view</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_reference']" position="after">
                    <field name="rent_order_id" invisible="rent_order_id == False" readonly="1"/>
                    <field name="maintenance_request_id" invisible="maintenance_request_id == False" readonly="1"/>
                </xpath>
            </field>
        </record>
        <record id="action_rent_invoices" model="ir.actions.act_window">
            <field name="name">Invoices</field>
            <field name="res_model">account.move</field>
            <field name="domain">[('rent_order_id', '!=', False)]</field>
            <field name="context">{'create': False}</field>
            <field name="view_mode">list,kanban,form</field>
        </record>
    </data>
</odoo>

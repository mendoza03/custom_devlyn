<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="update_last_odometer_view_form" model="ir.ui.view">
            <field name="name">update_last_odometer_view_form</field>
            <field name="model">update.last.odometer</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="equipment_ids" invisible="1"/>
                            <field name="equipment_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="last_odometer_reading"/>
                            <label for="current_odometer_reading"/>
                            <div class="o_row o_hr_narrow_field">
                                <field name="current_odometer_reading"/>
                                <field name="unit"/>
                            </div>
                        </group>
                    </group>
                    <footer>
                        <button name="update_readings" string="Update Readings" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="update_last_odometer_wizard_action" model="ir.actions.act_window">
            <field name="name">Update Odometer Reading</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">update.last.odometer</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
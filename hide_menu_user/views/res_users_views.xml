<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Inheriting fields to res.users and ir.ui.menu-->
    <record id="view_users_form" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.hide.menu.user</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Add button box to show restriction groups -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_restriction_groups" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-lock"
                        invisible="restriction_group_count == 0 or is_admin">
                    <field name="restriction_group_count" widget="statinfo" string="Restriction Groups"/>
                </button>
            </xpath>
            
            <!-- Add notebook page for individual menu restrictions -->
            <xpath expr="//notebook" position="inside">
                <page string="Hide Specific Menu" invisible="is_admin or is_show_specific_menu" name="hide_menu">
                    <group>
                        <group>
                            <field name="restriction_group_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Individual Menu Restrictions"/>
                    <field name="hide_menu_ids" widget="many2many" options="{'no_create': True}">
                        <list>
                            <field name="complete_name"/>
                            <field name="action"/>
                        </list>
                    </field>
                    <div class="alert alert-info" role="alert">
                        <strong>Note:</strong> Individual restrictions are applied in addition to any group restrictions above.
                    </div>
                </page>
            </xpath>
            
            <field name="name" position="after">
                <field name="is_admin" invisible="1"/>
                <field name="is_show_specific_menu" invisible="1"/>
            </field>
        </field>
    </record>
    
    <!--Inherited view of the model ir.ui.menu-->
    <record id="edit_menu_access" model="ir.ui.view">
        <field name="name">ir.ui.menu.view.form.inherit.hide.menu.user</field>
        <field name="model">ir.ui.menu</field>
        <field name="inherit_id" ref="base.edit_menu_access"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Restrict users" name="restrict_users">
                    <field name="restrict_user_ids" widget="many2many" options="{'no_create': True}">
                        <list>
                            <field name="name"/>
                            <field name="login"/>
                            <field name="email"/>
                        </list>
                    </field>
                    <div class="alert alert-info" role="alert">
                        <strong>Note:</strong> This list shows all users who have this menu restricted, 
                        either individually or through restriction groups.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_real_estate_extension_sign_request_view_form_inherit" model="ir.ui.view">
        <field name="name">sign.request.view.form.inherit</field>
        <field name="model">sign.request</field>
        <field name="inherit_id" ref="sign.sign_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='template_tags']" position="after">
                <field name="opportunity_id"/>
                <field name="sale_order_id"/>
                <field name="finance_time"/>
                <field name="property_contract_id"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button string="update contract data" name="update_partner_id_property_values" type="object" class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>

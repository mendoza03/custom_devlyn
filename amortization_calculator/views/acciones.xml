<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="amortization_calculator_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="amortization_calculator.report_amortization_calculator_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>


   <record id="action_report_amortization_calculator" model="ir.actions.report">
        <field name="name">Financial Year</field>
        <field name="model">amortization.calculator</field>
        <field name="report_type">qweb-pdf</field>
        <field name="print_report_name">'Property Sale Contract - %s' % object.name</field>
        <field name="report_name">amortization_calculator.amortization_calculator_template</field>
        <field name="report_file">amortization_calculator.amortization_calculator_template</field>
        <field name="binding_model_id" ref="model_amortization_calculator"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
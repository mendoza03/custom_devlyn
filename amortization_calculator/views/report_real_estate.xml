<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="property_sale_statement_doc">
        <t t-call="web.external_layout">
            <div class="page" style="line-height: 1.6;">
                <div class="row mt8">
                        Reporte
                </div>
            </div>
        </t>
    </template>

    <template id="property_statement_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="real_estate_bits.property_sale_statement_doc" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <record id="action_report_statement" model="ir.actions.report">
        <field name="name">Estado de cuenta</field>
        <field name="model">property.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="print_report_name">'Property Sale Contract - %s' % object.name</field>
        <field name="report_name">real_estate_bits.property_statement_template</field>
        <field name="report_file">real_estate_bits.property_statement_template</field>
        <field name="binding_model_id" ref="model_property_contract"/>
        <field name="binding_type">report</field>
    </record>

</odoo>

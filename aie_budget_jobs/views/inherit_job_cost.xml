<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_costing_form_inherit_budget" model="ir.ui.view">
        <field name="name">job.costing.form.inherit.budget</field>
        <field name="model">job.costing</field>
        <field name="inherit_id" ref="odoo_job_costing_management.job_costing_form_view"/>
        <field name="arch" type="xml">
            <field name="analytic_id" position="after">
                <field name="master_budget_id"/>
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                  <button name="action_view_requisitions"
                          type="object"
                          class="oe_stat_button"
                          icon="fa-truck">
                    <field name="requisition_count" widget="statinfo" string="Requisitions"/>
                  </button>
                    <button name="action_view_purchase_orders"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-shopping-cart">
                      <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                    </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_generate_purchase_order"
                    type="object"
                    class="oe_stat_button"
                    string="Subcontracting"
                    />
            </xpath>
        </field>
    </record>

    <record id="view_job_costing_list_inherit_budget_job" model="ir.ui.view">
        <field name="name">job.costing.list.inherit.budget.job</field>
        <field name="model">job.costing</field>
        <field name="inherit_id" ref="odoo_job_costing_management.job_costing_tree_view"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <button name="action_create_subcontracting"
                          type="object"
                          class="oe_stat_button"
                        string="Subcontracting">
                  </button>
            </field>
        </field>
    </record>
</odoo>



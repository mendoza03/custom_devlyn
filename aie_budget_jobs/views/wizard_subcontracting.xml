<odoo>
  <record id="view_job_costing_subcontracting_wizard_form" model="ir.ui.view">
    <field name="name">job.costing.subcontracting.wizard.form</field>
    <field name="model">job.costing.subcontracting.wizard</field>
    <field name="arch" type="xml">
      <form string="Subcontracting">
        <group>
          <field name="job_costing_id"/>
          <field name="job_cost_line_id"/>
          <field name="quantity"/>
        </group>
        <footer>
          <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>

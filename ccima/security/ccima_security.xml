<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="ccima_groups_category">
        <field name="name">Extra permissions</field>
        <field name="description">Groups related to the CCIMA</field>
        <field name="sequence">7</field>
    </record>

    <record id="group_access_saleman_assigner" model="res.groups">
        <field name="name">Saleman assigner</field>
        <field name="comment">Allows you to modify the seller of the contacts</field>
        <field name="category_id" ref="ccima_groups_category"/>

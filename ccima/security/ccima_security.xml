    <record id="group_access_show_only_costumer_assigned" model="res.groups">
        <field name="name">Show only assigned contacts</field>
        <field name="comment">Filter contacts to only show contacts to the assigned salesperson</field>
        <field name="category_id" ref="ccima_groups_category"/>
    </record>
</odoo>

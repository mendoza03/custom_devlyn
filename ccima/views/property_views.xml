<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_form" model="ir.ui.view">
        <field name="name">property.view.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="real_estate_bits.view_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">free,reserved,sold,on_lease</attribute>
            </xpath>
            <xpath expr="//field[@name='maintenance_type']" position="after">
                <field name="maintenance_charges" position="move"/>
                <field name="external_initial_maintenance_fee"/>
                <field name="external_amenity_maintenance_fee"/>
                <field name="external_maximum_maintenance_fee"/>
                <field name="utility_ids" position="move"/>
            </xpath>
            <xpath expr="//field[@name='maintenance_type']" position="before">
                <field name="terrain_type"/>
            </xpath>
            <xpath expr="//field[@name='property_date']" position="before">
                <field name="estimated_date"/>
            </xpath>
        </field>
    </record>

    <record id="view_property_kanban" model="ir.ui.view">
        <field name="name">property.view.kanban.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="real_estate_bits.view_property_kanban"/>
        <field name="arch" type="xml">
                <xpath expr="//div[@class='content']" position="attributes">
                    <attribute name="style">height: auto; max-height: 100%;</attribute>
                </xpath>
                <xpath expr="//li[.//field[@name='partner_id']]" position="before">
                    <li t="record.property_type_id.raw_value" class="o_force_ltr">
                        <b>Develop: </b>
                        <field name="worksite_id"/>
                    </li>   
                </xpath>
                <xpath expr="//li[.//field[@name='net_price']]" position="after">
                    <li t="record.property_type_id.raw_value" class="o_force_ltr">
                        <b>Terrain type: </b>
                        <field name="terrain_type"/>
                    </li>
                    <li t="record.property_type_id.raw_value" class="o_force_ltr">
                        <b>External charges: </b>
                        <field name="maintenance_charges"/>
                    </li>
                    <li t="record.property_type_id.raw_value" class="o_force_ltr">
                        <b>External initial maintenance fee: </b>
                        <field name="external_initial_maintenance_fee"/>
                    </li>
                    <li t="record.property_type_id.raw_value" class="o_force_ltr">
                        <b>External amenity maintenance fee: </b>
                        <field name="external_amenity_maintenance_fee"/>
                    </li>
                    <li t="record.property_type_id.raw_value" class="o_force_ltr">
                        <b>External maximum maintenance fee: </b>
                        <field name="external_maximum_maintenance_fee"/>
                    </li>
                </xpath>
                <xpath expr="//li[.//field[@name='property_type_id']]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//div[@class='ribbon ribbon-top-right']" position="replace">
                    <div t-if="record.active.raw_value" class="ribbon ribbon-top-right">
                        <t t-if="record.state.raw_value == 'free'">
                            <span class="text-bg-success">Available</span>
                        </t>
                        <t t-elif="record.state.raw_value == 'reserved'">
                            <span class="text-bg-warning">Reserved</span>
                        </t>
                        <t t-elif="record.state.raw_value == 'on_lease'">
                            <span class="text-bg-info">Lease</span>
                        </t>
                        <t t-elif="record.state.raw_value == 'sold'">
                            <span class="text-bg-danger">Sold</span>
                        </t>
                    </div>
                </xpath>
        </field>    
    </record>
</odoo>

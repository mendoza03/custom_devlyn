<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_ccima" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list[1]/field[@name='product_uom_qty']" position="attributes">
                <attribute name="string">Surface</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list[1]/field[@name='price_unit']" position="attributes">
                <attribute name="string">Unit price on list</attribute>
            </xpath>
        </field>
    </record>
</odoo>
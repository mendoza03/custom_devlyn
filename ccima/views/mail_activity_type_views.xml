<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_activity_type_view_form" model="ir.ui.view">
        <field name="name">mail.activity.type.view.form.inherit</field>
        <field name="model">mail.activity.type</field>
        <field name="inherit_id" ref="mail.mail_activity_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//h1" position="after">
                <h2>
                    <field name="short_name" placeholder="e.g. WA" options="{'line_breaks': False}" widget="text"/>
                </h2>
            </xpath>
            <xpath expr="//group[@name='activity_details']//field[@name='icon']" position="after">
                <field name="background_color" widget="color"/>
            </xpath>
        </field>
    </record>

</odoo>

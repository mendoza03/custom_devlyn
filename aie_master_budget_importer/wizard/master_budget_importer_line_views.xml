<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="master_budget_importer_line_view_form" model="ir.ui.view">
        <field name="name">master.budget.importer.line.view.form</field>
        <field name="model">master.budget.importer.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="filename"/>
                        </group>
                        <group>
                            <field name="state"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                        <field name="data_text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
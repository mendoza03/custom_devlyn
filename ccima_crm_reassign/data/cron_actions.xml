<odoo>
    <data>
        <record id="ir_cron_contract_brief_followups" model="ir.cron">
            <field name="name">Contract Brief: Daily Follow-ups</field>
            <field name="model_id" ref="model_rev_crm_contract_brief"/>
            <field name="state">code</field>
            <field name="code">model.cron_contract_brief_followups()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="server_action_product_archive_with_cancel_type" model="ir.actions.server">
        <field name="name">Archive with Cancel Type</field>
        <field name="model_id" ref="ccima_crm_reassign.model_rev_crm_contract_brief"/>
        <field name="binding_model_id" ref="ccima_crm_reassign.model_rev_crm_contract_brief"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
action = env.ref('ccima_crm_reassign.action_product_cancel_wizard').read()[0]
action['context'] = {
    'active_model': 'rev.crm.contract.brief',
    'active_id': record.id,
}
</field>

    </record>

    </data>
</odoo>

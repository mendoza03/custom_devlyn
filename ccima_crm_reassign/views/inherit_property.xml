<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_inherit_form" model="ir.ui.view">
        <field name="name">product.template.inherit.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="real_estate_bits.view_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="replace">
                <form string="Real Estate">
                    <header>
                        <button name="action_reservation" invisible="state != 'free'" string="Reservation" type="object"/>
                        <field name="state" widget="statusbar" clickable="true" statusbar_visible="free,reserved,on_lease,sold"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" name="view_maintenance" icon="fa-gears" type="object" invisible="maintenance_count == 0">
                                <field name="maintenance_count" string="Maintenance" widget="statinfo"/>
                            </button>
                            <button type="object" name="view_reservations" class="oe_stat_button" icon="fa-book" invisible="not reservation_count">
                                <field name="reservation_count" widget="statinfo" string="Reservations"/>
                            </button>

                        </div>

                        <div class="oe_title mb24">
                            <h1>
                                <field class="text-break" name="name" placeholder="Property Name" default_focus="1"
                                       required="1"/>
                            </h1>
                            <div class="o_row">
                                <field name="default_code" on_change="1" required="1" placeholder="Property Code"/>
                            </div>
                        </div>


                        <group>
                            <group string="Property Information">
                                <field name="worksite_id"/>
                                <field name="project_worksite_id"/>
                                <field name="condominium_worksite_id"/>
                                <field name="project_type" readonly="1"/>
                                <field name="lot"/>
                                <field name="terrain_type"/>
                                <field name="property_area"/>
                                <field name="price_per_m" string="Unit Price" required="1"/>
                                <field name="list_amount"/>
                                <field name="capital_gains"/>
                                <field name="property_date" />
                                <field name="month_deliver"/>
                                <field name="cancel_type_id"/>

                            </group>
                            <group >

                            </group>
                        </group>



                        <notebook>
                            <page string="Financing">
                                <group>
                                    <group>
                                        <field name="discount"/>
                                        <field name="price_unit" string="Unit Price"/>
                                        <field name="net_amount"/>
                                        <field name="down_payment_percent" widget="percentage"/>
                                        <field name="down_payment_amount"/>
                                        <field name="early_payment_percent" widget="percentage"/>
                                        <field name="early_payment_amount"/>
                                        <field name="final_down_payment"/>

                                    </group>
                                    <group>
                                        <field name="amount_to_finance"/>
                                        <field name="date_deliver"/>
                                        <field name="month_financing"/>
                                        <field name="final_amount"/>
                                        <field name="delivery_date"/>
                                        <field name="msi"/>
                                        <field name="month_0"/>
                                        <field name="monthly_percent_m"/>
                                        <field name="month_1"/>
                                        <field name="monthly_percent"/>
                                        <field name="month_125"/>
                                        <field name="total_paid"/>
                                    </group>
                                </group>

                            </page>

                            <page string="COMMITTEES">
                                <group>
                                    <group>
                                        <field name="scheme"/>
                                        <field name="lead"/>
                                    </group>
                                    <group>
                                        <field name="asesor"/>
                                        <field name="gerente"/>
                                        <field name="dvn"/>
                                        <field name="publici"/>
                                        <field name="cco"/>
                                    </group>
                                </group>
                            </page>

                            <page string="MAINTENANCE">
                                <group>
                                    <group>
                                        <field name="maintenance_charges"/>
                                        <field name="external_initial_maintenance_fee"/>
                                        <field name="external_amenity_maintenance_fee"/>
                                        <field name="external_maximum_maintenance_fee"/>
                                    </group>
                                    <group>
                                    </group>
                                </group>
                            </page>

                            <page string="LEGAL">
                                <group>
                                    <group>
                                        <field name="client_signature_date"/>
                                        <field name="physical_delivery_date"/>
                                        <field name="legal_representative_signature_date"/>
                                        <field name="contract_delivery_to_client_date"/>
                                        <field name="notarization_date"/>
                                    </group>
                                    <group>
                                    </group>
                                </group>

                            </page>

                            <page string="BINNACLE">
                                <field name="attachment_line_ids" class="o_website_sale_image_list"
                                       context="{'default_name': name, 'default_is_visible': False, 'default_filetype': 'pdf'}"
                                       mode="kanban" add-label="Add a Document" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>

                </form>

            </xpath>

        </field>
    </record>

    <record id="inherit_view_property_kanban" model="ir.ui.view">
        <field name="name">inherit.property.view.kanban</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="real_estate_bits.view_property_kanban"/>
        <field name="arch" type="xml">
                <xpath expr="//div[hasclass('content')]" position="replace">
                    <div class="content" style="height: auto; max-height: 100%;">
                        <h2>
                            <span t-if="record.name.raw_value" class="o_kanban_record_subtitle">
                                <field name="name"/>
                            </span>
                        </h2>
                        <span t-if="record.default_code.raw_value">
                            <field name="default_code"/>
                        </span>
                        <p>
                            <ul>
                                <li class="o_force_ltr">
                                    <b>Key: </b>
                                    <field name="key"/>
                                </li>
                                <li class="o_force_ltr">
                                    <b>Footage: </b>
                                    <field name="property_area"/>
                                </li>
                                <li t="record.property_type_id.raw_value" class="o_force_ltr">
                                    <b>Terrain type: </b>
                                    <field name="terrain_type"/>
                                </li>
                                <li t="record.property_type_id.raw_value" class="o_force_ltr">
                                    <b>P.U final: </b>
                                    <t t-if="record.price_unit.raw_value &gt; 0">
                                        <field name="price_unit"/>
                                    </t>
                                    <t t-else="">
                                        <field name="price_per_m"/>
                                    </t>
                                </li>
                                <li class="o_force_ltr">
                                    <b>Down payment to be paid: </b>
                                    <field name="down_payment_amount"/>
                                </li>
                                <li class="o_force_ltr">
                                    <b>Total to be paid: </b>
                                    <t t-if="record.price_unit.raw_value &gt; 0">
                                        <field name="list_amount"/>
                                    </t>
                                    <t t-else="">
                                        <field name="final_amount"/>
                                    </t>
                                </li>
                                <li class="o_force_ltr">
                                    <b>Amount to finance: </b>
                                    <field name="amount_to_finance"/>
                                </li>
                                <li class="o_force_ltr">
                                    <b> Internal maintenance fee: </b>
                                    <field name="maintenance_charges"/>
                                </li>
                                <li t="record.property_type_id.raw_value" class="o_force_ltr">
                                    <b>External initial maintenance fee: </b>
                                    <field name="external_initial_maintenance_fee"/>
                                </li>
                                <li class="o_force_ltr">
                                    <b>Capital gain: </b>
                                    <field name="capital_gains"/>
                                </li>
                                <li class="o_force_ltr">
                                    <b> Delivery date: </b>
                                    <field name="physical_delivery_date"/>
                                </li>
                            </ul>
                        </p>
                    </div>
                </xpath>

        </field>
    </record>


</odoo>
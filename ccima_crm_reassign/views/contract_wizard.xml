<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_loan_line_update_wizard" model="ir.actions.act_window">
        <field name="name">Update Loan Line</field>
        <field name="res_model">loan.line.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_loan_line_update_wizard_form" model="ir.ui.view">
        <field name="name">loan.line.update.wizard.form</field>
        <field name="model">loan.line.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Loan Lines">
                <group>
                    <field name="contract_id" required="1"/>
                </group>
                <group>
                    <field name="line_ids"
                       mode="list"
                       widget="one2many_list"
                       views="{'list': 'view_loan_line_update_wizard_line_tree'}"/>
                </group>
                <footer>
                    <button name="apply_update" type="object" string="Apply Changes" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_loan_line_update_wizard_line_tree" model="ir.ui.view">
        <field name="name">loan.line.update.wizard.line.tree</field>
        <field name="model">loan.line.update.wizard.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="loan_line_id" domain="[('contract_id', '=', parent.contract_id)]"/>
                <field name="amount_capital"/>
                <field name="amount_paid"/>
            </list>
        </field>
    </record>


    <menuitem id="menu_open_loan_line_update_wizard"
              name="Update Loan Line"
              parent="real_estate_bits.menu_property_contracts"
              sequence="50"
              action="action_loan_line_update_wizard"/>

</odoo>
<odoo>
  <template id="refund_request_form" name="Refund Request Form">
    <t t-call="website.layout">
      <div class="container my-4">
        <h2 class="text-center fw-bold">SOLICITUD DE DEVOLUCIÓN</h2>

        <t t-if="error">
          <div class="alert alert-danger" role="alert">
            <t t-esc="error"/>
          </div>
        </t>

        <form action="/refund/request/submit" method="post" class="mt-4">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

            <div class="col-12">
              <label class="form-label">CRM Lead / Opportunity</label>
              <select name="lead_id" id="lead_id" class="form-select">
                <option value="">-- Select --</option>
                <t t-foreach="leads" t-as="l">
                  <option t-att-value="l.id">
                    <t t-esc="l.name"/> - <t t-esc="l.partner_id.name or ''"/>
                  </option>
                </t>
              </select>
            </div>


          <!-- CUSTOMER DATA -->
          <div class="card mb-3">
            <div class="card-header fw-bold">DATOS DEL CLIENTE</div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-12 col-md-6">
                  <label class="form-label">Nombre del Cliente</label>
                  <input name="partner_name" id="partner_name" class="form-control" required="required"/>
                </div>

                <div class="col-12 col-md-6">
                  <label class="form-label d-block">Contactarme después</label>
                  <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="contact_after" value="yes" id="contact_yes"/>
                    <label class="form-check-label" for="contact_yes">Sí</label>
                  </div>
                  <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="contact_after" value="no" id="contact_no" checked="checked"/>
                    <label class="form-check-label" for="contact_no">No</label>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- UNIT DATA -->
          <div class="card mb-3">
            <div class="card-header fw-bold">DATOS DE LA UNIDAD</div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-12 col-md-6">
                  <label class="form-label">Desarrollo</label>
                  <input name="development_name" id="development_name" class="form-control" readonly="readonly"/>
                </div>

                <div class="col-12 col-md-6">
                  <label class="form-label">Referencia</label>
                  <input name="reference" class="form-control"/>
                </div>

                <div class="col-12 col-md-4">
                  <label class="form-label">Tipo de unidad</label>
                  <select name="unit_type" class="form-select" required="required">
                    <t t-foreach="unit_types" t-as="u">
                      <option t-att-value="u[0]"><t t-esc="u[1]"/></option>
                    </t>
                  </select>
                </div>

                <div class="col-12 col-md-4">
                  <label class="form-label">m²</label>
                  <input name="meters2" id="meters2" type="number" step="0.01" class="form-control"/>
                </div>

                <div class="col-12 col-md-4">
                  <label class="form-label">Importe (valor de la unidad)</label>
                  <input name="unit_amount" id="unit_amount" type="number" step="0.01" class="form-control"/>
                </div>

                <div class="col-12 col-md-6">
                  <label class="form-label">Contrato firmado</label>
                  <select name="contract_signed" class="form-select" required="required">
                    <option value="no">No</option>
                    <option value="yes">Sí</option>
                  </select>
                  <div class="form-text text-danger">
                    En caso de no tener contrato se denegará la devolución.
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- REFUND -->
          <div class="card mb-3">
            <div class="card-header fw-bold">DEVOLUCIÓN</div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-12 col-lg-6">
                  <h6 class="fw-bold">APARTADO</h6>
                  <div class="row g-2">
                    <div class="col-6"><input name="apartado_amount" type="number" step="0.01" class="form-control" placeholder="Monto"/></div>
                    <div class="col-6"><input name="apartado_payment_date" type="date" class="form-control" placeholder="Fecha de pago"/></div>
                    <div class="col-6">
                      <select name="apartado_payment_method" class="form-select">
                      </select>
                    </div>
                    <div class="col-6"><input name="apartado_discount" type="number" step="0.01" class="form-control" placeholder="Descuento"/></div>
                    <div class="col-12"><input name="apartado_real_refund" type="number" step="0.01" class="form-control" placeholder="Real a devolver"/></div>
                  </div>
                </div>

                <div class="col-12 col-lg-6">
                  <h6 class="fw-bold">ENGANCHE</h6>
                  <div class="row g-2">
                    <div class="col-6"><input name="enganche_amount" type="number" step="0.01" class="form-control" placeholder="Monto"/></div>
                    <div class="col-6"><input name="enganche_payment_date" type="date" class="form-control" placeholder="Fecha de pago"/></div>
                    <div class="col-6">
                      <select name="enganche_payment_method" class="form-select">
                        <option value="">Método de pago</option>
                        <t t-foreach="payment_methods" t-as="pm2">
                          <option t-att-value="pm2[0]"><t t-esc="pm2[1]"/></option>
                        </t>
                      </select>
                    </div>
                    <div class="col-6"><input name="enganche_discount" type="number" step="0.01" class="form-control" placeholder="Descuento"/></div>
                    <div class="col-12"><input name="enganche_real_refund" type="number" step="0.01" class="form-control" placeholder="Real a devolver"/></div>
                  </div>
                </div>

                <div class="col-12">
                  <div class="alert alert-info mb-0">
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- DOCUMENTS -->
          <div class="card mb-3">
            <div class="card-header fw-bold">DOCUMENTACIÓN A ENTREGAR</div>
            <div class="card-body">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="doc_request_signed" id="d1"/>
                <label class="form-check-label" for="d1">Solicitud de devolución firmada por el cliente</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="doc_official_id" id="d2"/>
                <label class="form-check-label" for="d2">Identificación Oficial (INE, pasaporte, cédula profesional con foto)</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="doc_clabe" id="d3"/>
                <label class="form-check-label" for="d3">CLABE interbancaria / estado de cuenta</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="doc_vouchers" id="d4"/>
                <label class="form-check-label" for="d4">Comprobantes de depósitos (VOUCHER)</label>
              </div>

              <div class="mt-3">
                <label class="form-label">Nota</label>
                <textarea name="note" class="form-control" rows="3"/>
              </div>
            </div>
          </div>

          <!-- REASON -->
          <div class="card mb-3">
            <div class="card-header fw-bold">MOTIVO DE DEVOLUCIÓN</div>
            <div class="card-body">
              <textarea name="refund_reason" class="form-control" rows="5" required="required"/>
            </div>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Enviar solicitud</button>
            <a href="/" class="btn btn-outline-secondary">Cancelar</a>
          </div>
        </form>
      </div>

    <script type="text/javascript">
  (function () {
    const leadSel = document.getElementById('lead_id');
    if (!leadSel) {
      return;
    }

    leadSel.addEventListener('change', async function () {
      const leadId = this.value;
      if (!leadId) {
        return;
      }

      const res = await fetch('/refund/request/lead_data', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          jsonrpc: '2.0',
          method: 'call',
          params: { lead_id: leadId }
        })
      });

      const data = await res.json();
      let j = null;
      if (data) {
        if (data.result) {
          j = data.result;
        } else {
          j = data;
        }
      }
      if (!j) {
        return;
      }
      if (!j.ok) {
        return;
      }

      function setVal(id, val) {
        const el = document.getElementById(id);
        if (!el) {
          return;
        }
        if (val === undefined) {
          return;
        }
        if (val === null) {
          return;
        }
        el.value = val;
      }

      setVal('partner_name', j.partner_name);
      setVal('development_name', j.development_name);
      setVal('meters2', j.meters2);
      setVal('unit_amount', j.unit_amount);
    });
  })();
</script>





    </t>
  </template>

  <template id="refund_request_thanks" name="Refund Request Thanks">
    <t t-call="website.layout">
      <div class="container my-5">
        <h3>Solicitud enviada</h3>
        <p>Gracias. Tu folio es: <strong><t t-esc="rid"/></strong></p>
      </div>
    </t>
  </template>
</odoo>

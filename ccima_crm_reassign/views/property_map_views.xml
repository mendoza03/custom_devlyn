<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Action -->
  <record id="action_property_map" model="ir.actions.act_window">
    <field name="name">Property Maps</field>
    <field name="res_model">property.map</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p>Create maps, upload an image, add lines with coordinates and a product.</p>
    </field>
  </record>

  <!-- Menu under CRM → Configuration (como pediste antes) -->
  <menuitem id="menu_map_template"
            name="Property Maps"
            parent="crm.crm_menu_config"
            action="action_property_map"
            sequence="12"
            groups="base.group_no_one"/>

  <!-- List view -->
  <record id="view_property_map_list" model="ir.ui.view">
    <field name="name">property.map.list</field>
    <field name="model">property.map</field>
    <field name="arch" type="xml">
      <list string="Property Maps">
        <field name="name"/>
        <field name="image"/>
      </list>
    </field>
  </record>

  <!-- Form view -->
  <record id="view_property_map_form" model="ir.ui.view">
    <field name="name">property.map.form</field>
    <field name="model">property.map</field>
    <field name="arch" type="xml">
      <form string="Property Map">
        <header>
          <button name="action_view_map" type="object" class="btn-primary" string="View Map"/>
        </header>
        <sheet>
          <group>
            <field name="name"/>
            <field name="image" widget="image"/>
          </group>
          <group string="Lines">
            <field name="line_ids" widget="one2many_list">
              <list editable="bottom">
                <field name="x_pct"/>
                <field name="y_pct"/>
                <field name="w_pct"/>
                <field name="h_pct"/>
                <field name="product_id"/>
              </list>
            </field>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Optional: standalone views for lines -->
  <record id="view_property_map_line_list" model="ir.ui.view">
    <field name="name">property.map.line.list</field>
    <field name="model">property.map.line</field>
    <field name="arch" type="xml">
      <list string="Map Lines">
        <field name="map_id"/>
        <field name="x_pct"/>
        <field name="y_pct"/>
        <field name="w_pct"/>
        <field name="h_pct"/>
        <field name="product_id"/>
      </list>
    </field>
  </record>

  <record id="view_property_map_line_form" model="ir.ui.view">
    <field name="name">property.map.line.form</field>
    <field name="model">property.map.line</field>
    <field name="arch" type="xml">
      <form string="Map Line">
        <sheet>
          <group>
            <field name="map_id"/>
            <field name="x_pct"/>
            <field name="y_pct"/>
            <field name="w_pct"/>
            <field name="h_pct"/>
            <field name="product_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_project_inherit_aie_master_budget" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="has_admin_access_master_budget" invisible="True"/>
                <field name="master_budget_line_id" readonly="not has_admin_access_master_budget" domain="[('type', '=', 'project')]" options='{"no_create": True}' groups="aie_master_budget.group_access_aie_master_budget_user,aie_master_budget.group_access_aie_master_budget_admin"/>                
            </xpath>
        </field>
    </record>
</odoo>
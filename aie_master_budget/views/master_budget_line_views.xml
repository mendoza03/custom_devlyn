<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="master_budget_line_view_form" model="ir.ui.view">
        <field name="name">master.budget.line.view.form</field>
        <field name="model">master.budget.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="complete_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="general_information" string="General information">
                            <field name="code"/>
                            <field name="name" required="1"/>
                            <field name="parent_id" domain="[('budget_id', '=', budget_id), ('type', '=', 'project')] if type == 'task' else [('budget_id', '=', budget_id), ('type', '=', 'task')] if type == 'concept' else [('budget_id', '=', budget_id), ('type', '=', 'concept')]" required="type != 'project'" readonly="type == 'project'"/>
                        </group>
                        <group>
                            <field name="budget_id" invisible="1"/>
                            <field name="budget_project_id" invisible="1"/>
                            <field name="type" required="1"/>
                            <field name="project_id" domain="[('id', '=', budget_project_id)]" required="type == 'project'" invisible="type != 'project'"/>
                            <field name="task_id" domain="[('project_id', '=', budget_project_id)]" required="type == 'task'" invisible="type != 'task'"/>
                            <field name="product_id" required="type == 'budget_item'" invisible="type != 'budget_item'"/>
                            <field name="price_unit" required="type == 'budget_item'" invisible="type != 'budget_item'"/>
                            <field name="quantity" required="type == 'budget_item'" invisible="type != 'budget_item'"/>
                            <field name="quantity_use" invisible="type != 'budget_item'"/>
                            <field name="performance" invisible="type != 'budget_item'"/>
                            <field name="product_uom" required="type == 'budget_item'" invisible="type != 'budget_item'"/>
                            <field name="price_total" invisible="type != 'budget_item'"/>
                            <field name="amount_use" invisible="type != 'budget_item'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="master_budget_line_view_tree" model="ir.ui.view">
        <field name="name">master.budget.line.view.list</field>
        <field name="model">master.budget.line</field>
        <field name="arch" type="xml">
            <list default_order="complete_name asc" editable="bottom">
                <field name="budget_id" column_invisible="1"/>
                <field name="budget_project_id" column_invisible="1"/>
                <field name="complete_name"/>
                <field name="code"/>
                <field name="name"/>
                <field name="type"/>
                <field name="parent_id" domain="[('budget_id', '=', budget_id), ('type', '=', 'project')] if type == 'task' else [('budget_id', '=', budget_id), ('type', '=', 'task')] if type == 'concept' else [('budget_id', '=', budget_id), ('type', '=', 'concept')]" required="type != 'project'" readonly="type == 'project'"/>
                <field name="project_id" domain="[('id', '=', budget_project_id)]" required="type == 'project'" invisible="type != 'project'"/>
                <field name="task_id" domain="[('project_id', '=', budget_project_id)]" required="type == 'task'" invisible="type != 'task'"/>
                <field name="product_id" required="type == 'budget_item'" invisible="type != 'budget_item'"/>
                <field name="price_unit" required="type == 'budget_item'" invisible="type not in ['budget_item', 'concept']"/>
                <field name="quantity"/>
                <field name="quantity_use"/>
                <field name="performance" invisible="type != 'budget_item'"/>
                <field name="product_uom" required="type == 'budget_item'" invisible="type != 'budget_item'"/>
                <field name="price_subtotal" column_invisible="1"/>
                <field name="price_total"/>
                <field name="amount_use"/>
                <field name="amount_residual"/>
                <field name="purchase_line_ids" widget="many2many_tags" column_invisible="1"/>
                <button string="Purchases" name="action_open_purchases" type="object" class="oe_highlight" invisible="not purchase_line_ids"/>
            </list>
        </field>
    </record>

    <record id="master_budget_line_action" model="ir.actions.act_window">
        <field name="name">Master Budget Line</field>
        <field name="res_model">master.budget.line</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

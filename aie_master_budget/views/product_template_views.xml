<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="after">
                <page string="Master budget" name="master_budget_tab" groups="aie_master_budget.group_access_aie_master_budget_user,aie_master_budget.group_access_aie_master_budget_admin">
                    <group>
                        <group>
                            <field name="has_admin_access_master_budget" invisible="True"/>
                            <field name="budget_price_unit" readonly="not has_admin_access_master_budget"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
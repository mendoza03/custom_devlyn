<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_amenities_view_form" model="ir.ui.view">
        <field name="name">project.amenities.view.form</field>
        <field name="model">project.amenities</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="code" required="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_amenities_view_list" model="ir.ui.view">
        <field name="name">project.amenities.view.list</field>
        <field name="model">project.amenities</field>
        <field name="arch" type="xml">
            <list string="Amenities">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="project_amenities_action" model="ir.actions.act_window">
        <field name="name">Amenities</field>
        <field name="res_model">project.amenities</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
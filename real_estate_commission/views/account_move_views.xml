<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="commission_upon_signing_id" invisible="1"/>
                <field name="commission_on_the_deed_id" invisible="1"/>
                <button name="action_show_commission"
                    class="oe_stat_button"
                    icon="fa-usd"
                    type="object"
                    groups="real_estate_commission.group_commission_manager"
                    invisible="not commission_upon_signing_id and not commission_on_the_deed_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Commission</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_property_form" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="real_estate_bits.view_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_type_id']" position="after">
                <field name="commission_percentage" groups="real_estate_commission.group_commission_manager"/>
            </xpath>
        </field>
    </record>

</odoo>
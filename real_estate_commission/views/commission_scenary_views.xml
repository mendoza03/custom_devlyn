<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="commission_scenary_view_form" model="ir.ui.view">
        <field name="name">commission.scenary.view.form</field>
        <field name="model">commission.scenary</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page name="lines" string="Factors">
                            <field name="factor_line_ids" mode="list">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="factor"/>
                                    <field name="default_percentage_commission_upon_signing"/>
                                    <field name="default_percentage_commission_on_the_deed"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_post="True" reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="commission_scenary_view_list" model="ir.ui.view">
        <field name="name">commission.scenary.view.list</field>
        <field name="model">commission.scenary</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="commission_scenary_action" model="ir.actions.act_window">
        <field name="name">Commission scenary</field>
        <field name="res_model">commission.scenary</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
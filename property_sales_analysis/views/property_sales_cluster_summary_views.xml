    <!-- Generator Form -->
    <record id="view_property_sales_cluster_summary_generator_form" model="ir.ui.view">
        <field name="name">property.sales.cluster.summary.generator.form</field>
        <field name="model">property.sales.cluster.summary.generator</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="cluster_id" domain="[('parent_id', '=', False)]"/>
                    <field name="calendar_id"/>
                </group>
                <footer>
                    <button name="action_generate"
                            type="object"
                            string="Generar Resumen del Cluster"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_property_sales_cluster_summary" model="ir.actions.act_window">
        <field name="name">Resumen por Cluster</field>
        <field name="res_model">property.sales.cluster.summary</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_property_sales_cluster_summary_generator" model="ir.actions.act_window">
        <field name="name">Generar Resumen del Cluster</field>
        <field name="res_model">property.sales.cluster.summary.generator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_property_sales_cluster_summary_generator"
              name="Generar Resumen por Cluster"
              parent="real_estate_bits.menu_real_estate_root"
              action="action_property_sales_cluster_summary_generator"
              sequence="15"/>

    <menuitem id="menu_property_sales_cluster_summary_list"

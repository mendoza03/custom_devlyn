<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_team_view_form" model="ir.ui.view">
        <field name="name">crm.team.view.form.inherit</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group>
                    <group name="assignment" string="Assignment">
                        <field name="tolerance_minutes" required="1"/>
                        <field name="type" required="1"/>
                        <field name="campaign_ids" widget="many2many_tags"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//page[@name='members_users']" position="after">
                <page name="percentages" string="Percentages" invisible="type != 'percentage'">
                    <field name="assign_percentage_ids" mode="list">
                        <list editable="bottom">
                            <field name="member_id" domain="[('id', 'in', parent.crm_team_member_ids)]"/>
                            <field name="percentage"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="crm_team_member_view_tree" model="ir.ui.view">
        <field name="name">crm.team.member.view.list.inherit</field>
        <field name="model">crm.team.member</field>
        <field name="inherit_id" ref="sales_team.crm_team_member_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="editable">bottom</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="company_id" invisible="1"/>
                <field name="user_in_teams_ids" invisible="1"/>
                <field name="user_company_ids" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
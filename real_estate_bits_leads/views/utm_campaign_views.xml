<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="utm_campaign_view_form" model="ir.ui.view">
        <field name="name">utm.campaign.view.form.inherit</field>
        <field name="model">utm.campaign</field>
        <field name="inherit_id" ref="utm.utm_campaign_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='top-group']" position="inside">
                <field name="restricted"/>
                <field name="crm_team_id" required="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Members" name="members_users">
                    <field name="crm_team_member_ids" mode="kanban" class="w-100">
                        <kanban>
                            <field name="id"/>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="image_128"/>
                            <templates>
                                <t t-name="kanban-box">
                                    <div class="oe_kanban_card oe_kanban_global_click">
                                        <div class="o_kanban_card_content d-flex">
                                            <div>
                                                <img t-att-src="kanban_image('crm.team.member', 'image_128', record.id.raw_value)" class="o_kanban_image o_image_64_cover" alt="Avatar"/>
                                            </div>
                                            <div class="oe_kanban_details d-flex flex-column ms-3">
                                                <strong class="o_kanban_record_title oe_partner_heading"><field name="name"/></strong>
                                                <div class="d-flex align-items-baseline text-break">
                                                    <i class="fa fa-envelope me-1" role="img" aria-label="Email" title="Email"/><field name="email"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
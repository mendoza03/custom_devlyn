<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_mm_contract_template_form" model="ir.ui.view">
    <field name="name">mm.contract.template.form</field>
    <field name="model">mm.contract.template</field>
    <field name="arch" type="xml">
      <form string="Contract Template">
        <sheet>
          <group>
            <field name="name"/>
            <field name="active"/>
          </group>

          <notebook>
            <page string="Header">
              <field name="header_html" widget="html"/>
            </page>
            <page string="Body">
              <field name="body_html" widget="html"/>
              <div class="oe_grey">
                Tokens examples: <code>{{ partner_id.name }}</code>, <code>{{ amount_total }}</code>
              </div>
            </page>
            <page string="Footer">
              <field name="footer_html" widget="html"/>
            </page>
            <page string="Notes">
              <field name="notes"/>
            </page>
            <page string="Fields">
              <field name="fields_help_origin"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mm_contract_template_list" model="ir.ui.view">
    <field name="name">mm.contract.template.list</field>
    <field name="model">mm.contract.template</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="action_mm_contract_template" model="ir.actions.act_window">
    <field name="name">Contract Templates</field>
    <field name="res_model">mm.contract.template</field>
    <field name="view_mode">list,form</field>
  </record>

    <menuitem id="menu_mm_contract_template"
          name="Contract Templates"
          parent="crm.crm_menu_config"
          action="action_mm_contract_template"
          sequence="20"/>



</odoo>

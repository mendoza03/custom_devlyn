#. module: real_estate_bits
#: model:mail.template,body_html:real_estate_bits.email_template_send_contract_reminder
msgid ""
"<table border=\"0\" cellpadding=\"0\" style=\"padding-top: 16px; background-color: #F1F1F1; color: #454748; width: 100%; border-collapse:separate;\">\n"
"                    <tr>\n"
"                        <td align=\"center\">\n"
"                            <table border=\"0\" width=\"590\" cellpadding=\"0\" style=\"padding: 16px; background-color: white; color: #454748; border-collapse:separate;\" summary=\"o_mail_notification\">\n"
"                                <tbody>\n"
"                                    <tr>\n"
"                                        <td align=\"center\">\n"
"                                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"690\" style=\"background-color: white; color: #454748; border-collapse:separate;\">\n"
"                                                <tbody>\n"
"                                                    <!-- HEADER -->\n"
"                                                    <tr>\n"
"                                                        <td align=\"center\" style=\"min-width: 690px;\">\n"
"                                                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"690\" style=\"min-width: 690px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                                                <tr>\n"
"                                                                    <td valign=\"middle\" style=\"font-size: 18px;color: #0e0e0f;line-height: 28px;\">\n"
"                                                                        <span style=\"font-size: 20px; font-weight: bold;\">\n"
"                                                                            Your property contract will expire soon :\n"
"                                                                            <t t-if=\"object.property_id.name\">\n"

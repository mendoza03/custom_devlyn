#. module: hide_any_menu_user_wise
#: model_terms:ir.ui.view,arch_db:hide_any_menu_user_wise.view_menu_restriction_group_form
msgid ""
"<strong>Granular Permissions:</strong> Configure specific access rights\n"
"                                (Read, Write, Create, Delete) and optional domain filters per menu.\n"
"                                Available domain variable: <strong>user</strong> (current user record).\n"
"                                Example: <code>[('user_id', '=', user.id)]</code>"
msgstr ""
"<strong>Permisos Granulares:</strong> Configure derechos de acceso específicos\n"
"                                (Leer, Escribir, Crear, Eliminar) y filtros de dominio opcionales por menú.\n"
"                                Variable de dominio disponible: <strong>user</strong> (registro del usuario actual).\n"
"                                Ejemplo: <code>[('user_id', '=', user.id)]</code>"

#. module: hide_any_menu_user_wise
#: model_terms:ir.ui.view,arch_db:hide_any_menu_user_wise.view_users_form
msgid ""
"<strong>Note:</strong> Individual restrictions are applied in addition to "
"any group restrictions above."
msgstr ""
"<strong>Nota:</strong> Las restricciones individuales se aplican además de "
"cualquier restricción de grupo arriba."

#. module: hide_any_menu_user_wise
#: model_terms:ir.ui.view,arch_db:hide_any_menu_user_wise.view_menu_restriction_permission_form
msgid ""
"<strong>Note:</strong> These permissions will apply to all users in the "
"restriction group."
msgstr ""
"<strong>Nota:</strong> Estos permisos se aplicarán a todos los usuarios en "
"el grupo de restricción."

#. module: hide_any_menu_user_wise
#: model_terms:ir.ui.view,arch_db:hide_any_menu_user_wise.edit_menu_access
msgid ""
"<strong>Note:</strong> This list shows all users who have this menu restricted, \n"
"                        either individually or through restriction groups."
msgstr ""
"<strong>Nota:</strong> Esta lista muestra todos los usuarios que tienen este menú restringido, \n"
"                        ya sea individualmente o a través de grupos de restricción."

#. module: hide_any_menu_user_wise
#: model_terms:ir.ui.view,arch_db:hide_any_menu_user_wise.view_menu_restriction_permission_form

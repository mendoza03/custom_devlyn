<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List view for Menu Restriction Hidden Button -->
    <record id="view_menu_restriction_button_list" model="ir.ui.view">
        <field name="name">menu.restriction.button.list</field>
        <field name="model">menu.restriction.button</field>
        <field name="arch" type="xml">
            <list string="Hidden Buttons">
                <field name="restriction_group_id"/>
                <field name="model_id"/>
                <field name="button_name"/>
                <field name="button_description"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form view for Menu Restriction Hidden Button -->
    <record id="view_menu_restriction_button_form" model="ir.ui.view">
        <field name="name">menu.restriction.button.form</field>
        <field name="model">menu.restriction.button</field>
        <field name="arch" type="xml">
            <form string="Hidden Button">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="restriction_group_id" readonly="context.get('default_restriction_group_id', False)"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="button_name"/>
                            <field name="button_description"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
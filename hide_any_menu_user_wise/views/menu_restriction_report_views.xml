<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List view for Menu Restriction Hidden Report -->
    <record id="view_menu_restriction_report_list" model="ir.ui.view">
        <field name="name">menu.restriction.report.list</field>
        <field name="model">menu.restriction.report</field>
        <field name="arch" type="xml">
            <list string="Hidden Reports">
                <field name="restriction_group_id"/>
                <field name="report_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form view for Menu Restriction Hidden Report -->
    <record id="view_menu_restriction_report_form" model="ir.ui.view">
        <field name="name">menu.restriction.report.form</field>
        <field name="model">menu.restriction.report</field>
        <field name="arch" type="xml">
            <form string="Hidden Report">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="restriction_group_id" readonly="context.get('default_restriction_group_id', False)"/>
                            <field name="report_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
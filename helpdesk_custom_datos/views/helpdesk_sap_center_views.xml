<odoo>

    <record id="view_helpdesk_sap_center_tree" model="ir.ui.view">
        <field name="name">helpdesk.sap.center.tree</field>
        <field name="model">helpdesk.sap.center</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="x_branch_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_helpdesk_sap_center_form" model="ir.ui.view">
        <field name="name">helpdesk.sap.center.form</field>
        <field name="model">helpdesk.sap.center</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="x_branch_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_sap_center" model="ir.actions.act_window">
        <field name="name">Centros SAP</field>
        <field name="res_model">helpdesk.sap.center</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_helpdesk_sap_center"
        name="Centros SAP"
        parent="helpdesk.helpdesk_menu_config"
        action="action_helpdesk_sap_center"
        sequence="50"
    />

</odoo>
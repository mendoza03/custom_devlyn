<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- PRIVILEGIO -->
    <!-- ===================================================== -->

    <record model="res.groups.privilege"
            id="res_groups_privilege_helpdesk_ticket_visibility">

        <field name="name">
            Helpdesk Ticket Visibility
        </field>

        <field name="category_id"
               ref="base.module_category_services"/>

    </record>

    <!-- ===================================================== -->
    <!-- GRUPO: SOLO TICKETS PROPIOS -->
    <!-- ===================================================== -->

    <record id="group_helpdesk_ticket_own_only"
            model="res.groups">

        <field name="name">
            Ver solo tickets propios
        </field>

        <field name="sequence">9</field>

        <field name="privilege_id"
               ref="res_groups_privilege_helpdesk_ticket_visibility"/>

        <field name="implied_ids"
               eval="[(4, ref('helpdesk.group_helpdesk_user'))]"/>

    </record>

    <!-- ===================================================== -->
    <!-- GRUPO: VER TODOS -->
    <!-- ===================================================== -->

    <record id="group_helpdesk_ticket_all"
            model="res.groups">

        <field name="name">
            Ver todos los tickets de Helpdesk
        </field>

        <field name="sequence">10</field>

        <field name="privilege_id"
               ref="res_groups_privilege_helpdesk_ticket_visibility"/>

        <field name="implied_ids"
               eval="[(4, ref('helpdesk.group_helpdesk_user'))]"/>

    </record>

    <!-- ===================================================== -->
    <!-- GRUPO: VER TICKETS POR SUBCATEGORIA -->
    <!-- ===================================================== -->

    <record id="group_helpdesk_ticket_subcategory_only"
            model="res.groups">

        <field name="name">
            Ver tickets por subcategoria asignada
        </field>

        <field name="sequence">11</field>

        <field name="privilege_id"
               ref="res_groups_privilege_helpdesk_ticket_visibility"/>

        <field name="implied_ids"
               eval="[(4, ref('helpdesk.group_helpdesk_user'))]"/>

    </record>

    <!-- ===================================================== -->
    <!-- GRUPO: PERMITIR EDITAR USUARIO ASIGNADO -->
    <!-- ===================================================== -->

    <record id="group_helpdesk_ticket_user_assignment_manager"
            model="res.groups">

        <field name="name">
            Editar usuario asignado en tickets
        </field>

        <field name="sequence">12</field>

        <field name="privilege_id"
               ref="res_groups_privilege_helpdesk_ticket_visibility"/>

        <field name="implied_ids"
               eval="[(4, ref('helpdesk.group_helpdesk_user'))]"/>

    </record>

    <!-- ===================================================== -->
    <!-- GRUPO: PERMITIR CAMBIO DE ESTADO -->
    <!-- ===================================================== -->

    <record id="group_helpdesk_ticket_stage_manager"
            model="res.groups">

        <field name="name">
            Cambiar estado de tickets
        </field>

        <field name="sequence">13</field>

        <field name="privilege_id"
               ref="res_groups_privilege_helpdesk_ticket_visibility"/>

        <field name="implied_ids"
               eval="[(4, ref('helpdesk.group_helpdesk_user'))]"/>

    </record>

    <!-- ===================================================== -->
    <!-- AJUSTE: USUARIO INTERNO NO DEBE HEREDAR MANAGER -->
    <!-- ===================================================== -->

    <record id="base.default_user_group"
            model="res.groups">
        <field name="implied_ids"
               eval="[(3, ref('helpdesk.group_helpdesk_manager')), (4, ref('helpdesk.group_helpdesk_user'))]"/>
    </record>

    <!-- ===================================================== -->
    <!-- ELIMINAR REGLAS ORIGINALES -->
    <!-- ===================================================== -->

    <delete id="helpdesk.helpdesk_ticket_user_rule"
            model="ir.rule"/>

    <delete id="helpdesk.helpdesk_sla_report_analysis_rule_user"
            model="ir.rule"/>

    <delete id="helpdesk.helpdesk_ticket_report_analysis_rule_user"
            model="ir.rule"/>

    <!-- ===================================================== -->
    <!-- SOLO TICKETS PROPIOS -->
    <!-- ===================================================== -->

    <record id="helpdesk_ticket_user_own_or_assigned_rule"
            model="ir.rule">

        <field name="name">
            Helpdesk Ticket: Own or Assigned
        </field>

        <field name="model_id"
               ref="helpdesk.model_helpdesk_ticket"/>

        <field name="groups"
               eval="[(4, ref('helpdesk_custom_datos.group_helpdesk_ticket_own_only'))]"/>

        <field name="domain_force">
            [
                '|',
                ('created_by_user_id', '=', user.id),
                ('user_id', '=', user.id)
            ]
        </field>

    </record>

    <!-- ===================================================== -->
    <!-- VER TODOS -->
    <!-- ===================================================== -->

    <record id="helpdesk_ticket_all_tickets_rule"
            model="ir.rule">

        <field name="name">
            Helpdesk Ticket: All Tickets
        </field>

        <field name="model_id"
               ref="helpdesk.model_helpdesk_ticket"/>

        <field name="groups"
               eval="[(4, ref('helpdesk_custom_datos.group_helpdesk_ticket_all'))]"/>

        <field name="domain_force">
            [(1, '=', 1)]
        </field>

    </record>

    <!-- ===================================================== -->
    <!-- SOLO TICKETS POR SUBCATEGORIA -->
    <!-- ===================================================== -->

    <record id="helpdesk_ticket_subcategory_user_rule"
            model="ir.rule">

        <field name="name">
            Helpdesk Ticket: Subcategory Users
        </field>

        <field name="model_id"
               ref="helpdesk.model_helpdesk_ticket"/>

        <field name="groups"
               eval="[(4, ref('helpdesk_custom_datos.group_helpdesk_ticket_subcategory_only'))]"/>

        <field name="domain_force">
            [
                '|',
                '|',
                ('x_subcategory_id.user_ids', 'in', [user.id]),
                '|',
                ('x_subcategory_id', 'in', user.x_helpdesk_subcategory_ids.ids),
                ('x_category_id', 'in', user.x_helpdesk_category_ids.ids),
                ('x_section_id', 'in', user.x_helpdesk_section_ids.ids)
            ]
        </field>

    </record>

    <!-- ===================================================== -->
    <!-- SLA REPORT - SOLO PROPIOS -->
    <!-- ===================================================== -->

    <record id="helpdesk_sla_report_user_rule"
            model="ir.rule">

        <field name="name">
            Helpdesk SLA Report: Own or Assigned
        </field>

        <field name="model_id"
               ref="helpdesk.model_helpdesk_sla_report_analysis"/>

        <field name="groups"
               eval="[(4, ref('helpdesk_custom_datos.group_helpdesk_ticket_own_only'))]"/>

        <field name="domain_force">
            [
                '|',
                ('ticket_id.created_by_user_id', '=', user.id),
                ('ticket_id.user_id', '=', user.id)
            ]
        </field>

    </record>

    <!-- ===================================================== -->
    <!-- SLA REPORT - VER TODOS -->
    <!-- ===================================================== -->

    <record id="helpdesk_sla_report_all_rule"
            model="ir.rule">

        <field name="name">
            Helpdesk SLA Report: All
        </field>

        <field name="model_id"
               ref="helpdesk.model_helpdesk_sla_report_analysis"/>

        <field name="groups"
               eval="[(4, ref('helpdesk_custom_datos.group_helpdesk_ticket_all'))]"/>

        <field name="domain_force">
            [(1, '=', 1)]
        </field>

    </record>

    <!-- ===================================================== -->
    <!-- REPORT ANALYSIS - SOLO PROPIOS -->
    <!-- ===================================================== -->

    <record id="helpdesk_ticket_report_user_rule"
            model="ir.rule">

        <field name="name">
            Helpdesk Ticket Report: Own or Assigned
        </field>

        <field name="model_id"
               ref="helpdesk.model_helpdesk_ticket_report_analysis"/>

        <field name="groups"
               eval="[(4, ref('helpdesk_custom_datos.group_helpdesk_ticket_own_only'))]"/>

        <field name="domain_force">
            [
                '|',
                ('ticket_id.created_by_user_id', '=', user.id),
                ('ticket_id.user_id', '=', user.id)
            ]
        </field>

    </record>

    <!-- ===================================================== -->
    <!-- REPORT ANALYSIS - VER TODOS -->
    <!-- ===================================================== -->

    <record id="helpdesk_ticket_report_all_rule"
            model="ir.rule">

        <field name="name">
            Helpdesk Ticket Report: All
        </field>

        <field name="model_id"
               ref="helpdesk.model_helpdesk_ticket_report_analysis"/>

        <field name="groups"
               eval="[(4, ref('helpdesk_custom_datos.group_helpdesk_ticket_all'))]"/>

        <field name="domain_force">
            [(1, '=', 1)]
        </field>

    </record>

</odoo>

                <!-- <chatter/> -->
            <!-- </form> -->

            <form string="To-do"
                  class="o_todo_form_view"
                  js_class="todo_form">
                <header>
                    <field name="personal_stage_type_id"
                           domain="[('user_id','=',uid)]"
                           widget="statusbar"
                           options="{'clickable': '1', 'fold_field': 'fold'}"/>
                    <field name="active" invisible="1"/>
                </header>
                <sheet class="o_todo_form_sheet_bg">
                    <widget name="web_ribbon" class="todo_archived" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title pe-0">
                        <h1 class="d-flex justify-content-between align-items-center">
                            <div class="d-flex w-100">
                                <field name="priority" widget="priority_switch" class="me-3"/>
                                <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="To-do..."/>
                            </div>
                            <div class="d-flex justify-content-end o_state_container">
                                <field name="state" widget="todo_done_checkmark" class="o_task_state_widget"/>
                            </div>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <!-- <field name="is_task" invisible="1"/> -->
                            <field name="is_task_custom" invisible="1"/>
                            <!-- <field name="is_project" invisible="1"/> -->
                            <field name="is_project_custom" invisible="1"/>
                            <field name="user_ids"
                                widget="many2many_avatar_user"
                                required="1"
                                options="{'no_quick_create': True}"
                                placeholder="Assignees"/>
                            <!-- <field name="custom_note_project_id" options="{'no_create_edit': True}" required="is_project"/> -->
                            <field name="custom_note_project_id" options="{'no_create_edit': True}" required="is_project_custom"/>
                        </group>
                        <group>
                            <field name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color', 'no_create_edit': True}"
                                class="me-2"/>
                            <!-- <field name="task_id" options="{'no_create_edit': True}"
                               invisible="not is_task" required="is_project"/> -->
                            <field name="task_id" options="{'no_create_edit': True}"
                                   invisible="not is_task_custom" required="is_project_custom"/>
                        </group>
                    </group>
                    <field name="description" type="html" class="oe_description" default_focus="1" options="{'resizable': false, 'collaborative': true}"
                        placeholder="Type Here..."/>
                </sheet>
                <widget name="todo_chatter_panel"/>
            </form>
        </field>
    </record>

    <!-- Search Construction Project note  -->
    <record id="view_project_note_note_filter" model="ir.ui.view">
      <field name="name">project.task.search</field>
      <field name="model">project.task</field>
      <field name="arch" type="xml">
        <search string="Notes">
          <field name="tag_ids"/>
          <field name="task_id"/>
          <field name="custom_note_project_id"/>
          <field name="company_id" invisible="1"/>
          <group expand="0" string="Group By">
            <filter string="Stage" name="personal_stage_type_id" help="By sticky note Category" context="{'group_by':'personal_stage_type_id'}"/>
            <filter string="Task" name="task" context="{'group_by':'task_id'}"/>
            <filter string="Project" name="project" context="{'group_by':'custom_note_project_id'}"/>
          </group>
        </search>
      </field>
    </record>

    <record id="project_task_note_view_activity" model="ir.ui.view">
        <field name="name">project.task.view.note.activity</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <activity string="Notes">
                <field name="user_ids"/>
                <templates>
                    <div class="w-100" t-name="activity-box" style="display: inline-grid; grid-template-columns: auto max-content;">
                        <div>
                            <span t-att-title="record.name.value">
                                <field name="name" display="full" class="w-100 o_text_block align-middle"/>
                            </span>
                        </div>
                        <field name="user_ids" widget="many2many_avatar_user" readonly="True"/>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <!-- Action Construction Project Note -->
    <record id="action_project_note_note" model="ir.actions.act_window">
      <field name="name">Notes</field>
      <field name="res_model">project.task</field>
      <field name="view_mode">kanban,form,list,activity</field>
      <field name="search_view_id" ref="view_project_note_note_filter"/>
      <!-- <field name="context">{'default_is_project': True}</field>
      <field name="domain">[('is_project','=',True),('user_ids', 'in', [uid]), ('project_id', '=', False), ('parent_id', '=', False)]</field> -->
      <field name="context">{'default_is_project_custom': True}</field>
      <field name="domain">[('is_project_custom','=',True),('user_ids', 'in', [uid]), ('project_id', '=', False), ('parent_id', '=', False)]</field>
    </record>
    
    <record id="action_project_note_tree" model="ir.actions.act_window.view">
        <field eval="2" name="sequence"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_project_note_note_tree"/>
        <field name="act_window_id" ref="action_project_note_note"/>
    </record>

    <record id="action_project_note_form" model="ir.actions.act_window.view">
        <field eval="3" name="sequence"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_project_note_note_form"/>
        <field name="act_window_id" ref="action_project_note_note"/>
    </record>

    <record id="action_project_note_kanban" model="ir.actions.act_window.view">
        <field eval="1" name="sequence"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_const_project_note_note_kanban"/>
        <field name="act_window_id" ref="action_project_note_note"/>
    </record>

    <record id="action_project_note_activity" model="ir.actions.act_window.view">
        <field eval="4" name="sequence"/>
        <field name="view_mode">activity</field>
        <field name="view_id" ref="project_task_note_view_activity"/>
        <field name="act_window_id" ref="action_project_note_note"/>
    </record>

    <!-- Action Construction Task Note -->
    <record id="action_task_note_note" model="ir.actions.act_window">
      <field name="name">Notes</field>
      <field name="res_model">project.task</field>
      <field name="view_mode">kanban,form,list,activity</field>
      <field name="search_view_id" ref="view_project_note_note_filter"/>
      <!-- <field name="context">{'default_is_task': True}</field>
      <field name="domain">[('is_task','=',True),('user_ids', 'in', [uid]), ('project_id', '=', False), ('parent_id', '=', False)]</field> -->
      <field name="context">{'default_is_task_custom': True}</field>
      <field name="domain">[('is_task_custom','=',True),('user_ids', 'in', [uid]), ('project_id', '=', False), ('parent_id', '=', False)]</field>
    </record>

    <record id="action_task_note_activity" model="ir.actions.act_window.view">
        <field eval="4" name="sequence"/>
        <field name="view_mode">activity</field>
        <field name="view_id" ref="project_task_note_view_activity"/>
        <field name="act_window_id" ref="action_task_note_note"/>
    </record>

    <record id="action_project_task_note_tree" model="ir.actions.act_window.view">
        <field eval="2" name="sequence"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_project_note_note_tree"/>
        <field name="act_window_id" ref="action_task_note_note"/>
    </record>

    <record id="action_project_task_note_form" model="ir.actions.act_window.view">
        <field eval="3" name="sequence"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_project_note_note_form"/>
        <field name="act_window_id" ref="action_task_note_note"/>
    </record>

    <record id="action_project_task_note_kanban" model="ir.actions.act_window.view">
        <field eval="1" name="sequence"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_const_project_note_note_kanban"/>
        <field name="act_window_id" ref="action_task_note_note"/>
    </record>

    <menuitem id="notes_job_project_menu" parent="menu_job_cost_project" name="Project Notes" action="action_project_note_note" 
              sequence="80"/>
    <menuitem id="notes_job_cost_task_menu" parent="menu_job_cost_orders" name="Job Notes" action="action_task_note_note" 
              sequence="2"/>

</odoo>